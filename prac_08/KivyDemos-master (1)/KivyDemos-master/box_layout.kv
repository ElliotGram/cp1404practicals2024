BoxLayout:
    id: mother
    orientation: 'vertical'
#    orientation: 'horizontal'
    Button:
        text: 'Clear'
        on_release: app.press_clear()

    TextInput:
        id: input_name
        text: ''
    Button:
        id: output_label
        text: "Greet"
        on_press: app.handle_greet()
    Label:
        text: 'Enter your name'
        color: (1, 1, 0, 1)